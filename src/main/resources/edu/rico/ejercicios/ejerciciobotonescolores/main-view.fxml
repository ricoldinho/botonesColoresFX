<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.rico.ejercicios.ejerciciobotonescolores.Controller">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <TextField fx:id="inputTextField" promptText="valores válidos 1,2 o 3" maxWidth="200.0" />

    <Button fx:id="reactionButton" onAction="#onReactionButtonClick" text="Reaction" />

    <Label fx:id="errorLabel" textFill="RED" wrapText="true" textAlignment="CENTER" alignment="CENTER" maxWidth="260.0" />

    <VBox VBox.vgrow="ALWAYS" />

    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="leftButton" text="Botón 1" prefWidth="80.0" prefHeight="35.0" />
        <Button fx:id="middleButton" text="Botón 2" prefWidth="80.0" prefHeight="35.0" />
        <Button fx:id="rightButton" text="Botón 3" prefWidth="80.0" prefHeight="35.0" />
    </HBox>
</VBox>
